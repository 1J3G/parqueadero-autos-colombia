# Configuración de Entorno - Parqueadero Autos Colombia
APP_NAME="Parqueadero Autos Colombia API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Conexión a Base de Datos MySQL
# Formato: mysql+pymysql://<usuario>:<password>@<host>:<puerto>/<nombre_bd>
DATABASE_URL="mysql+pymysql://root:@localhost:3306/parqueadero_autos_colombia"

# Para desarrollo ágil sin servicio MySQL activo, puedes usar SQLite descomentando la siguiente línea:
# DATABASE_URL="sqlite:///./parqueadero.db"

# Clave secreta para JWT y firmas
SECRET_KEY="tu_super_clave_secreta_aqui_autos_colombia_2026"
